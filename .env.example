# ====================================================
# PRIME RESERVE BANK - Environment Variables Configuration
# Educational Banking Web Application
# ====================================================

# Django Core Settings
SECRET_KEY=django-insecure-prime-reserve-bank-secret-key-2026-demo
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Database Engine: 'mysql' or 'sqlite'
# If DB_ENGINE=sqlite, the application uses SQLite seamlessly.
# If DB_ENGINE=mysql, configure MySQL database credentials below:
DB_ENGINE=sqlite
DB_NAME=prime_reserve_bank_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# OTP & Demonstration Mode
# DEMO_OTP_DISPLAY: If True, displays generated OTP in UI banner for local presentation convenience
DEMO_OTP_DISPLAY=True

# ====================================================
# Real Gmail SMTP Configuration (For Email OTP & Welcome Mails)
# ====================================================
# Note: For Gmail, EMAIL_HOST_PASSWORD must be a 16-character
# Google App Password generated from:
# https://myaccount.google.com/apppasswords (with 2-Step Verification enabled)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=deepakjaiswal822007@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_google_app_password
DEFAULT_FROM_EMAIL=PRIME RESERVE BANK <deepakjaiswal822007@gmail.com>
