# ====================================================
# PRIME RESERVE BANK - Environment Variables Example
# Educational Banking Web Application
# ====================================================

# Django Core Settings
SECRET_KEY=django-insecure-prime-reserve-bank-secret-key-2026-demo
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Engine: 'mysql' or 'sqlite'
# For college / production evaluation with MySQL:
# Set DB_ENGINE=mysql and configure MySQL server credentials below.
# If DB_ENGINE=sqlite or MySQL connection fails in local testing,
# the app seamlessly defaults to SQLite for local development convenience.
DB_ENGINE=mysql
DB_NAME=prime_reserve_bank_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# OTP & Demonstration Mode
# DEMO_OTP_DISPLAY: If True, displays generated OTP directly in UI alert box for instant demo/testing
DEMO_OTP_DISPLAY=True

# Optional Email Backend Settings (for Email OTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@primereservebank.demo
